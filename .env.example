# Local dev: matches docker-compose.yml. In production, use the connection
# string from your Vercel Postgres store (Storage tab -> .env.local snippet,
# usually exposed as POSTGRES_URL) and map it to DB_DATABASE_URL below.
DB_DATABASE_URL=postgres://sedpayroll:sedpayroll@localhost:5432/sedpayroll

# Auth.js — generate with: bunx auth secret  (or: openssl rand -base64 33)
# Required in every environment, including on Vercel.
AUTH_SECRET=

# Optional: pins the callback URL for local dev. Not needed on Vercel —
# lib/auth.config.ts sets `trustHost: true`, so Auth.js reads the real host
# from request headers there (works for both production and preview URLs).
AUTH_URL=http://localhost:3000
