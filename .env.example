# Local dev: matches docker-compose.yml. In production, use the connection
# string from your Vercel Postgres store (Storage tab -> .env.local snippet,
# usually exposed as POSTGRES_URL) and map it to DATABASE_URL below.
DATABASE_URL=postgres://sedpayroll:sedpayroll@localhost:5432/sedpayroll

# Auth.js — generate with: bunx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=

# Base URL Auth.js should trust for callbacks. Set to your deployed URL on Vercel.
AUTH_URL=http://localhost:3000
